# Ambiente
NODE_ENV=development
PORT=3001
LOG_LEVEL=info

# Banco PostgreSQL
# Local:
DATABASE_URL=postgresql://postinder_user:postinder_pass@127.0.0.1:5433/postinder_db
# Deploy: use a connection string do PostgreSQL hospedado.

# Autenticacao
JWT_SECRET=troque-esta-chave-em-producao-com-uma-string-longa
JWT_EXPIRY_MINUTES=15
JWT_REFRESH_EXPIRY_DAYS=7

# Frontend e CORS
# APP_PUBLIC_URL e usada para links enviados aos clientes.
APP_PUBLIC_URL=http://localhost:5173
# Use CORS_ORIGINS para liberar URLs extras separadas por virgula.
# Exemplo: https://postinder.vercel.app,https://preview-postinder.vercel.app
CORS_ORIGINS=

# Upload em producao
# Em desenvolvimento os arquivos ficam em /uploads.
# Em producao, configure Supabase Storage.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=postinder-uploads

# WhatsApp via Z-API opcional
# Sem estas variaveis, o backend usa modo local-preview.
ZAPI_INSTANCE=
ZAPI_TOKEN=
ZAPI_CLIENT_TOKEN=

# Integracoes futuras/opcionais
RESEND_API_KEY=
ANTHROPIC_API_KEY=
