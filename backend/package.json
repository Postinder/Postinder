{
  "name": "postinder-backend",
  "version": "1.0.0",
  "packageManager": "npm@11.13.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed-demo": "tsx scripts/seedDemo.ts",
    "db:bootstrap-admin": "tsx scripts/bootstrapAdmin.ts",
    "db:validate-email-uniqueness": "tsx scripts/validateEmailUniqueness.ts",
    "db:validate-storage-metadata": "tsx scripts/validateStorageMetadata.ts",
    "db:validate-storage-duplication": "tsx scripts/validateStorageDuplication.ts",
    "db:audit-shared-storage-files": "tsx scripts/auditSharedStorageFiles.ts",
    "storage:cleanup-retention": "tsx scripts/cleanupStorageRetention.ts",
    "db:validate-storage-retention": "tsx scripts/validateStorageRetention.ts",
    "db:cleanup-legacy-archived": "tsx scripts/cleanupLegacyArchivedPosts.ts",
    "test": "tsx --test src/modules/soundtracks/domain/Soundtrack.test.ts src/modules/clients/clientInput.test.ts src/modules/platformSettings/platformSettings.test.ts src/modules/portal/portalApproval.test.ts src/modules/posts/storageRetention.test.ts src/shared/middlewares/authBoundary.test.ts src/modules/maintenance/demoReset.test.ts src/shared/utils/logSanitizer.test.ts src/shared/middlewares/adminAuthorization.test.ts src/modules/integrations/aiInsights.test.ts src/modules/branding/branding.test.ts",
    "test:auth": "tsx --test src/shared/middlewares/authBoundary.test.ts",
    "test:c02": "tsx --test src/modules/maintenance/demoReset.test.ts",
    "test:h02": "tsx --test src/shared/utils/logSanitizer.test.ts",
    "test:h03": "tsx --test src/shared/middlewares/adminAuthorization.test.ts",
    "test:h04": "tsx --test src/modules/integrations/aiInsights.test.ts",
    "test:integration:soundtracks": "tsx scripts/validateSoundtracks.ts",
    "test:integration:portal-approval": "tsx --test src/modules/portal/portalApproval.integration.test.ts",
    "db:setup": "npm run db:migrate",
    "build": "tsc",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.106.2",
    "@types/multer": "^2.1.0",
    "@types/pg": "^8.20.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.6",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.2.0",
    "pg": "^8.20.0",
    "pngjs": "^7.0.0",
    "sharp": "^0.35.0",
    "uuid": "^14.0.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.20",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^24.0.0",
    "@types/pngjs": "^6.0.5",
    "tsx": "^4.21.0",
    "typescript": "^5.2.2"
  }
}
