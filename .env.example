# Banco local do Docker
DATABASE_URL=postgresql://postinder_user:postinder_password@localhost:5433/postinder_db

# Backend
NODE_ENV=development
PORT=3001
JWT_SECRET=troque-esta-chave-em-producao
JWT_EXPIRY_MINUTES=15
JWT_REFRESH_EXPIRY_DAYS=7
LOG_LEVEL=info

# URL publica usada para montar links enviados ao cliente.
# Localmente use o Vite. No deploy, troque pela URL real do site.
APP_PUBLIC_URL=http://localhost:5173

# WhatsApp via Z-API.
# Em ambiente local pode deixar vazio; o backend retorna modo local-preview.
ZAPI_INSTANCE=
ZAPI_TOKEN=
ZAPI_CLIENT_TOKEN=

# E-mail via Resend, reservado para notificacoes futuras.
RESEND_API_KEY=
