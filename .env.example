# Banco local do Docker
DATABASE_URL=postgresql://postinder_user:postinder_pass@127.0.0.1:5433/postinder_db

# Backend
NODE_ENV=development
PORT=3001
LOG_LEVEL=info
JWT_SECRET=troque-esta-chave-em-producao-com-uma-string-longa
JWT_EXPIRY_MINUTES=15
JWT_REFRESH_EXPIRY_DAYS=7

# URL publica do frontend
APP_PUBLIC_URL=http://localhost:5173
CORS_ORIGINS=

# Upload em producao via Supabase Storage
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=postinder-uploads

# WhatsApp via Z-API
ZAPI_INSTANCE=
ZAPI_TOKEN=
ZAPI_CLIENT_TOKEN=

# E-mail/IA opcionais
RESEND_API_KEY=
ANTHROPIC_API_KEY=
